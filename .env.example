# Copy this file to .env.local and fill in the values.
# On Vercel, add the same variables under Project > Settings > Environment Variables.

# Browser key: shows the map. Restrict it to "Maps JavaScript API" and your site
# addresses (https://under50.vercel.app/* and http://localhost:3000/*).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server key: restaurant search, details, photos, attractions and activities.
# Restrict it to "Places API (New)". Never expose it in the browser.
GOOGLE_PLACES_API_KEY=

# PostgreSQL connection string used by Prisma
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Optional: region used to bias searches (default: ca)
# REGION_CODE=ca
